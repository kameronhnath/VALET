nextflow.enable.types = true
workflow.output.mode = 'copy'

apptainer.enabled = true

profiles {

    // Profile used to run multiple assemblies at once
    multiple {
        params.ignore_end_distances = 100
        params.threads = 5
    }
    
    // Test profile to run with provided test data
    test {
        params.assembly = "${projectDir}/data/test_split.fasta"
        params.reads1 = "${projectDir}/data/lib1.1.fastq"
        params.reads2 = "${projectDir}/data/lib1.2.fastq"
        params.ignore_end_distances = 100
        params.suspicious_flank_size = 0
        params.threads = 5

        outputDir = "${projectDir}/output"

        trace {
            enabled = true
            file = "trace.tsv"
            overwrite = true
        }
    }

    // Example parameters to run valet on a cluster -> sets time and memory limits for each process
    cluster {

        params.threads = 4

        process{
            executor = 'slurm'

            withName: FILTER_CONTIGS {
                cpus = 2
                memory = 512.MB
                time = 30.m
            }
            
            withName: RUN_BOWTIE {
                cpus = 4
                time = 4.h
                memory = 16.GB
            }

            withName: CONTIG_LENGTHS {
                cpus = 1
                time = 30.m
                memory = 512.MB
            }

            withName: RUN_SAMTOOLS {
                cpus = 2
                time = 4.h
                memory = 8.GB
            }

            withName: CONTIG_COVERAGE {
                cpus = 1
                memory = 1.GB
                time = 1.h
            }

            withName: SPLIT_PILEUP {
                cpus = 1
                memory = 1.GB
                time = 30.m
            }

            withName: DEPTH_OF_COVERAGE {
                cpus = 4
                memory = 2.GB
                time = 1.h
            }

            withName: MERGE_BEDS_COVERAGE {
                cpus = 1
                memory = 512.MB
                time = 30.m
            }

            withName: BREAKPOINT_SPLITTER {
                cpus = 1
                memory = 1.GB
                time = 1.h
            }

            withName: BREAKPOINT_FINDER {
                cpus = 4
                memory = 16.GB
                time = 2.h
            }

            withName: BREAKPOINT_BED_SORT {
                cpus = 1
                memory = 512.MB
                time = 30.m
            }

            withName: BIN_READS_AND_CONTIGS{
                cpus = 2
                memory = 16.GB
                time = 4.h
            }

            withName: RUN_BWA {
                cpus = 2
                memory = 256.MB
                time = 30.m
                maxForks = 20
            }

            withName: SAM_TO_BAM {
                cpus = 1
                memory = 128.MB
                time = 10.m
                maxForks = 20
            }

            withName: MATE_PAIR_CHECKER {
                cpus = 1
                memory = 256.MB
                time = 30.m
                maxForks = 20
            }

            withName: MERGE_BEDS_MATE_ERROR {
                cpus = 1
                memory = 512.MB
                time = 30.m
            }

            withName: GENERATE_SUMMARY {
                cpus = 1
                memory = 512.MB
                time = 30.m
            }

            withName: FIND_SUSPICIOUS_REGIONS {
                cpus = 1
                memory = 512.MB
                time = 30.m
            }
        }
    }

}